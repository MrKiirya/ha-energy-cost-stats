#!/bin/sh
# Linux / container / CI setup: install all dependency groups, including Home Assistant.
set -eu
cd "$(dirname "$0")/.."

if ! command -v uv >/dev/null 2>&1; then
    echo "uv is not installed. Install it: https://docs.astral.sh/uv/getting-started/installation/" >&2
    exit 1
fi

uv sync --group ha "$@"
