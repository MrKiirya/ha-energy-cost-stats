#!/bin/sh
# Headless smoke check: start the dev Home Assistant instance from script/develop
# in the background, wait until it answers on :8123, confirm energy_cost_stats set
# up cleanly, then stop it. Linux / container / CI only; reused by 003-ci.
set -eu
cd "$(dirname "$0")/.."

case "$(uname 2>/dev/null || echo unknown)" in
    MINGW* | MSYS* | CYGWIN*)
        echo "Home Assistant does not run natively on Windows; use the devcontainer." >&2
        exit 1
        ;;
esac

if command -v curl >/dev/null 2>&1 && curl -s -o /dev/null "http://127.0.0.1:8123/manifest.json"; then
    echo "Something is already listening on :8123; stop it before running this script." >&2
    exit 1
fi

SMOKE_TIMEOUT="${SMOKE_TIMEOUT:-600}"
TMP_DIR="$(mktemp -d)"
LOG_FILE="$TMP_DIR/ha.log"
HASS_PID=""

cleanup() {
    if [ -n "$HASS_PID" ] && kill -0 "$HASS_PID" 2>/dev/null; then
        kill -TERM "$HASS_PID" 2>/dev/null || true
        i=0
        while kill -0 "$HASS_PID" 2>/dev/null && [ "$i" -lt 30 ]; do
            i=$((i + 1))
            sleep 1
        done
        if kill -0 "$HASS_PID" 2>/dev/null; then
            kill -KILL "$HASS_PID" 2>/dev/null || true
        fi
        wait "$HASS_PID" 2>/dev/null || true
    fi
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT INT TERM

cp config/configuration.yaml "$TMP_DIR/configuration.yaml"

HA_CONFIG_DIR="$TMP_DIR" sh script/develop >"$LOG_FILE" 2>&1 &
HASS_PID=$!

# Wait for HTTP 200 on :8123 (the frontend stage) and a log line showing
# energy_cost_stats was set up. The custom integration is set up in a later
# bootstrap stage than the frontend/http domain, so a single check right after
# the port opens is too early; poll both conditions in the same loop.
#
# Neither is enough on its own to declare success: Home Assistant only decides
# whether to fall back to "recovery mode" (a stripped-down restart without
# custom integrations, triggered when a CRITICAL_INTEGRATIONS domain such as
# `frontend` didn't load) at the very end of its bootstrap, in
# "Home Assistant initialized in ...s" -- well after the port opens and
# energy_cost_stats sets up on the *first* (possibly doomed) attempt. Exiting
# as soon as the early signals show up would report a false OK for a run that
# later fell back to recovery mode. So keep polling for the recovery-mode
# marker and the "initialized" marker too, and only declare success once
# bootstrap is fully finished with no recovery-mode fallback recorded anywhere
# in the log.
elapsed=0
port_ready=0
integration_ready=0
bootstrap_done=0
while [ "$elapsed" -lt "$SMOKE_TIMEOUT" ]; do
    if ! kill -0 "$HASS_PID" 2>/dev/null; then
        echo "script/develop exited before finishing startup." >&2
        tail -n 100 "$LOG_FILE" >&2 || true
        exit 1
    fi

    if grep -qE "Activating recovery mode" "$LOG_FILE"; then
        echo "Home Assistant fell back to recovery mode (a required domain, e.g. frontend, did not load)." >&2
        tail -n 150 "$LOG_FILE" >&2 || true
        exit 1
    fi

    if grep -qE "Setup failed for .*energy_cost_stats|Error during setup of component energy_cost_stats|Unable to (find|prepare|set up) .*energy_cost_stats" "$LOG_FILE"; then
        echo "Found an energy_cost_stats setup error in the log." >&2
        tail -n 100 "$LOG_FILE" >&2 || true
        exit 1
    fi

    # default_config: a dependency failure here (tasks/008-dev-ha-fixes.md
    # decision 4) is a real dev-environment regression -- with the go2rtc
    # binary pinned in the devcontainer image, default_config sets up
    # cleanly, so this must fail, not only be reported. HA wording from
    # homeassistant/setup.py, unchanged between 2025.4.0 and 2026.9.3.
    if grep -qE "Setup failed for .*'default_config'|Unable to set up dependencies of 'default_config'" "$LOG_FILE"; then
        echo "default_config failed to set up its dependencies (see tasks/008-dev-ha-fixes.md)." >&2
        tail -n 150 "$LOG_FILE" >&2 || true
        exit 1
    fi

    if [ "$port_ready" -ne 1 ] && curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:8123/manifest.json" 2>/dev/null | grep -q "^200$"; then
        port_ready=1
    fi

    if [ "$integration_ready" -ne 1 ] && grep -qE "Setting up energy_cost_stats|Setup of domain energy_cost_stats" "$LOG_FILE"; then
        integration_ready=1
        integration_line="$(grep -E "Setting up energy_cost_stats|Setup of domain energy_cost_stats" "$LOG_FILE" | head -n 1)"
    fi

    if grep -qE "Home Assistant initialized in" "$LOG_FILE"; then
        bootstrap_done=1
        break
    fi

    sleep 3
    elapsed=$((elapsed + 3))
done

if [ "$port_ready" -ne 1 ]; then
    echo "Home Assistant did not answer on :8123 within ${SMOKE_TIMEOUT}s." >&2
    tail -n 100 "$LOG_FILE" >&2 || true
    exit 1
fi

if [ "$integration_ready" -ne 1 ]; then
    echo "No log line showing energy_cost_stats was set up within ${SMOKE_TIMEOUT}s." >&2
    tail -n 100 "$LOG_FILE" >&2 || true
    exit 1
fi

if [ "$bootstrap_done" -ne 1 ]; then
    echo "Home Assistant did not finish bootstrap (\"Home Assistant initialized in ...s\") within ${SMOKE_TIMEOUT}s." >&2
    tail -n 100 "$LOG_FILE" >&2 || true
    exit 1
fi

# Re-check after full bootstrap: recovery mode can in principle only appear
# once bootstrap decides to fall back, which is also when "initialized" is
# logged, so re-scanning the full log here catches any last-moment fallback.
if grep -qE "Activating recovery mode" "$LOG_FILE"; then
    echo "Home Assistant fell back to recovery mode (a required domain, e.g. frontend, did not load)." >&2
    tail -n 150 "$LOG_FILE" >&2 || true
    exit 1
fi

echo "OK: HTTP 200 on :8123; log line: ${integration_line}"

# Report only (tasks/008-dev-ha-fixes.md decision 4): a live install at HA
# startup means the pre-install helper (script/setup / script/develop) missed
# something -- a regression of tasks/008-dev-ha-fixes.md items 2 or 3 -- but
# it is not itself a fatal error here (network/discovery flakiness would make
# a hard failure noisy). "Attempting install of" is HA's
# util/package.py::install_package() log line.
if grep -qE "Attempting install of" "$LOG_FILE"; then
    echo "Live installs during this run (see tasks/008-dev-ha-fixes.md):"
    grep -E "Attempting install of" "$LOG_FILE"
else
    echo "Live installs during this run: no live installs"
fi

exit 0
