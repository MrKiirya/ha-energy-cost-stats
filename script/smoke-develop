#!/bin/sh
# Headless smoke check: start the dev Home Assistant instance from script/develop
# in the background, wait until it answers on :8123, confirm energy_cost_stats set
# up cleanly, then stop it. Linux / container / CI only; reused by 003-ci.
set -eu
cd "$(dirname "$0")/.."

case "$(uname 2>/dev/null || echo unknown)" in
    MINGW* | MSYS* | CYGWIN*)
        echo "Home Assistant does not run natively on Windows; use the devcontainer." >&2
        exit 1
        ;;
esac

if command -v curl >/dev/null 2>&1 && curl -s -o /dev/null "http://127.0.0.1:8123/manifest.json"; then
    echo "Something is already listening on :8123; stop it before running this script." >&2
    exit 1
fi

SMOKE_TIMEOUT="${SMOKE_TIMEOUT:-600}"
TMP_DIR="$(mktemp -d)"
LOG_FILE="$TMP_DIR/ha.log"
HASS_PID=""

cleanup() {
    if [ -n "$HASS_PID" ] && kill -0 "$HASS_PID" 2>/dev/null; then
        kill -TERM "$HASS_PID" 2>/dev/null || true
        i=0
        while kill -0 "$HASS_PID" 2>/dev/null && [ "$i" -lt 30 ]; do
            i=$((i + 1))
            sleep 1
        done
        if kill -0 "$HASS_PID" 2>/dev/null; then
            kill -KILL "$HASS_PID" 2>/dev/null || true
        fi
        wait "$HASS_PID" 2>/dev/null || true
    fi
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT INT TERM

cp config/configuration.yaml "$TMP_DIR/configuration.yaml"

HA_CONFIG_DIR="$TMP_DIR" sh script/develop >"$LOG_FILE" 2>&1 &
HASS_PID=$!

# Wait for both: HTTP 200 on :8123 (the frontend stage) and a log line showing
# energy_cost_stats was set up. The custom integration is set up in a later
# bootstrap stage than the frontend/http domain, so a single check right after
# the port opens is too early; poll both conditions in the same loop.
elapsed=0
port_ready=0
integration_ready=0
while [ "$elapsed" -lt "$SMOKE_TIMEOUT" ]; do
    if ! kill -0 "$HASS_PID" 2>/dev/null; then
        echo "script/develop exited before finishing startup." >&2
        tail -n 100 "$LOG_FILE" >&2 || true
        exit 1
    fi

    if [ "$port_ready" -ne 1 ] && curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:8123/manifest.json" 2>/dev/null | grep -q "^200$"; then
        port_ready=1
    fi

    if grep -qE "Setting up energy_cost_stats|Setup of domain energy_cost_stats" "$LOG_FILE"; then
        integration_ready=1
    fi

    if grep -qE "Setup failed for .*energy_cost_stats|Error during setup of component energy_cost_stats|Unable to (find|prepare|set up) .*energy_cost_stats" "$LOG_FILE"; then
        echo "Found an energy_cost_stats setup error in the log." >&2
        tail -n 100 "$LOG_FILE" >&2 || true
        exit 1
    fi

    if [ "$port_ready" -eq 1 ] && [ "$integration_ready" -eq 1 ]; then
        break
    fi

    sleep 3
    elapsed=$((elapsed + 3))
done

if [ "$port_ready" -ne 1 ]; then
    echo "Home Assistant did not answer on :8123 within ${SMOKE_TIMEOUT}s." >&2
    tail -n 100 "$LOG_FILE" >&2 || true
    exit 1
fi

if [ "$integration_ready" -ne 1 ]; then
    echo "No log line showing energy_cost_stats was set up within ${SMOKE_TIMEOUT}s." >&2
    tail -n 100 "$LOG_FILE" >&2 || true
    exit 1
fi

echo "OK: Home Assistant answered on :8123 and energy_cost_stats set up cleanly."
exit 0
